# OpenClaw Business Assistant — Environment Variables
# Copy this to .env and fill in your actual values
# This file is gitignored — your secrets stay local

# === REQUIRED ===

# Generate one: openssl rand -hex 20
# (deploy.sh and the Docker entrypoint generate one automatically if empty)
OPENCLAW_GATEWAY_TOKEN=""

# Gateway bind interface.
# "loopback" for running directly on your machine (openclaw gateway run).
# Docker overrides this to "lan" inside the container automatically —
# the container port is only published on the host's loopback, so it
# stays private either way.
OPENCLAW_GATEWAY_BIND="loopback"

# === OPTIONAL — Model Provider ===

# Set your primary model (e.g. "openai/gpt-4o", "anthropic/claude-sonnet-4-20250514", "google/gemini-2.5-flash")
# If using a custom provider, also configure models.providers in openclaw.json
PRIMARY_MODEL=""

# API key for whichever provider PRIMARY_MODEL uses — set the one you need:
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""
# GEMINI_API_KEY=""
# OPENROUTER_API_KEY=""
# XAI_API_KEY=""
# For local models, run Ollama on the host — no key needed.

# === OPTIONAL — Telegram ===

# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=""

# === OPTIONAL — Google Workspace ===

# Google OAuth credentials (Gmail, Calendar, Drive access)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_ACCESS_TOKEN=""
GOOGLE_REFRESH_TOKEN=""
